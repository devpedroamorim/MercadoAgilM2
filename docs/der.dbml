// ========================================
// USERS AND PROFILES
// ========================================

Table users {
  id integer [pk, increment]
  email varchar [not null, unique]
  password_hash varchar [not null]
  role varchar [not null]
}

Table customers {
  id integer [pk, increment]
  user_id integer [not null, unique]
  name varchar [not null]
  cpf varchar(11) [not null, unique]
  state varchar(2) [not null]
}

Table sellers {
  id integer [pk, increment]
  user_id integer [not null, unique]
  store_name varchar [not null]
  cnpj varchar(14) [not null, unique]
}


// ========================================
// PRODUCT CATALOG
// ========================================

Table categories {
  id integer [pk, increment]
  name varchar [not null, unique]
  tax_rate decimal(5,2) [not null]
  commission_rate decimal(5,2) [not null]
}

Table products {
  id integer [pk, increment]
  seller_id integer [not null]
  category_id integer [not null]
  name varchar [not null]
  price decimal(12,2) [not null]
  stock integer [not null, default: 0]
}


// ========================================
// ORDERS
// ========================================

Table orders {
  id integer [pk, increment]
  customer_id integer [not null]
  status varchar [not null, default: 'aberto']
  subtotal decimal(12,2) [not null, default: 0]
  discount decimal(12,2) [not null, default: 0]
  shipping decimal(12,2) [not null, default: 0]
  total decimal(12,2) [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
}

Table order_items {
  id integer [pk, increment]
  order_id integer [not null]
  product_id integer [not null]
  quantity integer [not null]
  unit_price decimal(12,2) [not null]

  indexes {
    (order_id, product_id) [unique]
  }
}


// ========================================
// COUPONS
// ========================================

Table coupons {
  id integer [pk, increment]
  code varchar [not null, unique]
  type varchar [not null]
  value decimal(12,2) [not null]
  expires_at timestamp [not null]
  minimum_value decimal(12,2) [not null, default: 0]
  cumulative boolean [not null, default: false]
}

Table order_coupons {
  order_id integer [not null]
  coupon_id integer [not null]

  indexes {
    (order_id, coupon_id) [pk]
  }
}


// ========================================
// RELATIONSHIPS
// ========================================

// One-to-one (1:1)

Ref: users.id - customers.user_id
Ref: users.id - sellers.user_id

// One-to-many (1:N)

Ref: customers.id < orders.customer_id
Ref: sellers.id < products.seller_id
Ref: categories.id < products.category_id

// Many-to-many (N:N): Orders and Products

Ref: orders.id < order_items.order_id
Ref: products.id < order_items.product_id

// Many-to-many (N:N): Orders and Coupons

Ref: orders.id < order_coupons.order_id
Ref: coupons.id < order_coupons.coupon_id
